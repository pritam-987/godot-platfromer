[sub_resource type="GDScript" id="GDScript_hjaqi"]
resource_name = "res://scene/player.gd"
script/source = "extends CharacterBody2D


@onready var animated_sprite = $AnimatedSprite2D
@onready var variable_jump_timer: Timer = $VariableJumpTimer
@onready var cayote_timer: Timer = $CayoteTimer
@onready var jump_buffer_timer: Timer = $JumpBufferTimer
@onready var audio_stream_player_2d: AudioStreamPlayer2D = $AudioStreamPlayer2D

const SPEED = 130.0
const JUMP_VELOCITY = -300.0

@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D

func _physics_process(delta: float) -> void:
	
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"jump\"):
		jump_buffer_timer.start()
		if (is_on_floor() or not cayote_timer.is_stopped()):
			if not jump_buffer_timer.is_stopped():
				variable_jump_timer.start()
				#print(\"buffer jump\")
				velocity.y = JUMP_VELOCITY
				jump_buffer_timer.stop()
				audio_stream_player_2d.play()
	

		

	# Gets the movement direction:-1, 0. 1
	var direction := Input.get_axis(\"move_left\", \"move_right\")
	#flip the sprite
	if direction > 0:
		animated_sprite.flip_h = false 
	elif direction < 0:
		animated_sprite.flip_h = true
	
	#animations
	if direction == 0:
		animated_sprite.play(\"idle\")
	else:
		animated_sprite.play(\"run\")
		
	#store past floor data 
	var was_on_floor = is_on_floor()
	# applies the direction
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	#apply corner correction
	corner_correction(3)
	move_and_slide()

	# check if the player was on floor but not now
	if was_on_floor and not is_on_floor():
		cayote_timer.start()
func _ready():
	animated_sprite.play(\"idle\")

func _on_variable_jump_timer_timeout() -> void:
	if !Input.is_action_pressed(\"jump\"):
		velocity.y *= 0.0
		
		#if velocity.y < -175:
			#velocity.y = -175
			#print(\"low jump\")
		#else:
			#print(\"high jump\")
# corner corection
func corner_correction(amount: int):
	var delta = get_physics_process_delta_time()
	if velocity.y < 0 and test_move(global_transform, Vector2(0, velocity.y*delta)):
			for i in range(0, amount + 1):
				for j in [-1.0, 1.0]:
					if not test_move(global_transform.translated(Vector2(i * j, 0)), Vector2(0, velocity.y * delta)):
						translate(Vector2(i * j, 0))
						#global_position.x = round(global_position.x / 16) * 16  - 1.99*j
						#if velocity.x * j < 0: velocity.x = 0
						return
"

